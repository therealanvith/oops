# ==============================================================================
# ServiceDesk Environment Variables Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit real credentials or .env files to source control.
# ==============================================================================

# Database name for local PostgreSQL instance (Docker Compose)
POSTGRES_DB=servicedesk

# Database user for local PostgreSQL instance
POSTGRES_USER=servicedesk_user

# Database password for local PostgreSQL instance (change in production)
POSTGRES_PASSWORD=servicedesk_dev_password

# Port mapped to local PostgreSQL host (default: 5432)
POSTGRES_PORT=5432

# Active Spring profile: 'local' (Docker Compose / local DB) or 'cloud' (Supabase direct session connection)
SPRING_PROFILES_ACTIVE=local

# JDBC connection URL used by Spring Boot backend
# Local default: jdbc:postgresql://postgres:5432/servicedesk (or localhost:5432 if running outside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/servicedesk

# Spring datasource username matching PostgreSQL credentials
SPRING_DATASOURCE_USERNAME=servicedesk_user

# Spring datasource password matching PostgreSQL credentials
SPRING_DATASOURCE_PASSWORD=servicedesk_dev_password

# Secret key used for signing JWT tokens in upcoming authentication phases (min 256-bit / 32+ characters)
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_at_least_32_bytes_long

# Comma-separated list of allowed CORS origins for backend API access
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL for Spring Boot REST API consumed by Next.js frontend client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
