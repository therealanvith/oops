# Set default behaviour to automatically normalize line endings
* text=auto eol=lf

# Force scripts and shell configs to LF
*.sh text eol=lf
lefthook.yml text eol=lf
.coderabbit.yaml text eol=lf
scripts/* text eol=lf
mvnw text eol=lf

# Windows command scripts must have CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

